{
  "name": "nimbus-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:python": "cd python-ai && python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
    "start:server": "cd server && npm start",
    "start:python": "cd python-ai && .venv\\Scripts\\python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"npm run start:python\" \"npm run start:server\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
